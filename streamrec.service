# ~/.config/systemd/user/streamrec.service
[Unit]
Description=streamrec scheduler (records streams listed in ~/.config/streamrec/schedule.toml)

[Service]
ExecStart=%h/.venvs/streamrec/bin/python %h/streamrec/streamrec.py schedule %h/.config/streamrec/schedule.toml --dir %h/recordings
Restart=always
RestartSec=10
# let the scheduler stop its recordings cleanly; systemd kills leftovers afterwards
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
